--------------------------------------------------
--- Base Template of a ship with all variables and functions organized by type
--- Variables: https://github.com/HWRM/KarosGraveyard/wiki/Variable;-Ship
--- Functions: https://github.com/HWRM/KarosGraveyard/wiki/Scope;-Ship
--------------------------------------------------

NewShipType = StartShipConfig()

--------------------------------------------------
--- Shipinfo
--------------------------------------------------

NewShipType.displayedName = "GVC Mentu"
NewShipType.sobDescription = "Advanced Cruiser"

--------------------------------------------------
--- Main Ship Data
--------------------------------------------------

NewShipType.isTransferable = 1
NewShipType.unavailableWhenCaptured = 1 -- Added from template

--------------------------------------------------
--- Families
--------------------------------------------------

NewShipType.MinimalFamilyToFindPathAround = "MotherShip"
NewShipType.BuildFamily = "Cruiser_Vas"
NewShipType.AttackFamily = "Frigate"
NewShipType.DockFamily = "Frigate"
NewShipType.AvoidanceFamily = "Frigate"
NewShipType.DisplayFamily = "Frigate"
NewShipType.AutoFormationFamily = "Frigate"
NewShipType.CollisionFamily = "Big"
NewShipType.ArmourFamily = "MediumArmour"

--------------------------------------------------
--- Supply
--------------------------------------------------

-- Added from template; values are defaults and may need adjustment.
setSupplyValue(NewShipType, "Cruiser", 1.0)
setSupplyValue(NewShipType, "LayoutCruiser", 1.0)

--------------------------------------------------
--- Construction
--------------------------------------------------

NewShipType.buildBatch = getShipNum(NewShipType, "buildBatch", 1) -- Added from template
NewShipType.buildCost = 1475
NewShipType.buildTime = 70
NewShipType.buildPriorityOrder = 40

--------------------------------------------------
--- Health and Armour
--------------------------------------------------

NewShipType.maxhealth = 60000
NewShipType.regentime = 600
NewShipType.minRegenTime = 600
NewShipType.sideArmourDamage = 1.2
NewShipType.rearArmourDamage = 1.2

--------------------------------------------------
--- Shields
--------------------------------------------------

addShield(NewShipType, "EMP", 320, 18)

