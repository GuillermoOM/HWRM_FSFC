--------------------------------------------------
--- Base Template of a ship with all variables and functions organized by type
--- Variables: https://github.com/HWRM/KarosGraveyard/wiki/Variable;-Ship
--- Functions: https://github.com/HWRM/KarosGraveyard/wiki/Scope;-Ship
--------------------------------------------------

NewShipType = StartShipConfig()

--------------------------------------------------
--- Shipinfo
--------------------------------------------------

NewShipType.displayedName = "GTI Arcadia"
NewShipType.sobDescription = "Installation"

--------------------------------------------------
--- Main Ship Data
--------------------------------------------------

NewShipType.isTransferable = 0
NewShipType.unavailableWhenCaptured = 0 -- Added from template

--------------------------------------------------
--- Families
--------------------------------------------------

NewShipType.MinimalFamilyToFindPathAround = "MotherShip"
NewShipType.BuildFamily = "Shipyard_Ter"
NewShipType.AttackFamily = "Chimera"
NewShipType.DockFamily = "CantDock"
NewShipType.AvoidanceFamily = "SuperPriority"
NewShipType.DisplayFamily = "Capital"
NewShipType.AutoFormationFamily = "CapShip"
NewShipType.CollisionFamily = "Unmoveable"
NewShipType.ArmourFamily = "HeavyArmour"

--------------------------------------------------
--- Supply
--------------------------------------------------

setSupplyValue(NewShipType, "Installation", 1.0) -- Added from template

--------------------------------------------------
--- Construction
--------------------------------------------------

NewShipType.buildBatch = getShipNum(NewShipType, "buildBatch", 1) -- Added from template
NewShipType.buildCost = 10000
NewShipType.buildTime = 200
NewShipType.buildPriorityOrder = 40
setConcurrentBuildLimit(NewShipType, 0, 4) -- Added from template

--------------------------------------------------
--- Health and Armour
--------------------------------------------------

NewShipType.maxhealth = 400000
NewShipType.regentime = 1788
NewShipType.minRegenTime = 1788
NewShipType.sideArmourDamage = 1.0
NewShipType.rearArmourDamage = 1.0

--------------------------------------------------
--- Shields
--------------------------------------------------

addShield(NewShipType, "EMP", 10000, 100)

--------------------------------------------------
--- Sensors
--------------------------------------------------

NewShipType.retaliationRange = 7000
NewShipType.retaliationDistanceFromGoal = 160
NewShipType.visualRange = 2050
NewShipType.prmSensorRange = 10000
NewShipType.secSensorRange = 18000
NewShipType.detectionStrength = 1

--------------------------------------------------
--- Movement
--------------------------------------------------

NewShipType.mass = 10000000
NewShipType.thrusterMaxSpeed = 0
NewShipType.thrusterAccelTime = 1
NewShipType.thrusterBrakeTime = 1
NewShipType.mainEngineMaxSpeed = 0
NewShipType.mainEngineAccelTime = 1
NewShipType.mainEngineBrakeTime = 1
NewShipType.rotationMaxSpeed = 0
NewShipType.rotationAccelTime = 10
NewShipType.rotationBrakeTime = 5

--------------------------------------------------
--- Advanced Movement
--------------------------------------------------

NewShipType.controllerType = "Ship"
NewShipType.thrusterUsage = 1
NewShipType.accelerationAngle = 60
NewShipType.mirrorAngle = 0
NewShipType.secondaryTurnAngle = 0
NewShipType.maxBankingAmount = 10
NewShipType.descendPitch = 40
NewShipType.goalReachEpsilon = 50
NewShipType.slideMoveRange = 350
NewShipType.relativeMoveFactor = 1
NewShipType.useEngagementRanges = 1

--------------------------------------------------
--- Tactics And Multipliers
--------------------------------------------------

NewShipType.defaultStance = "Neutral" -- Added from template
NewShipType.defaultROE = "Defensive" -- Added from template
setTacticsMults(NewShipType, "WEAPONDAMAGE", 1.25, 0.75, 1.0) -- Added from template
setTacticsMults(NewShipType, "BULLETSPEED", 1.10, 0.90, 1.0) -- Added from template
setTacticsMults(NewShipType, "DAMAGEAPPLIED", 1.10, 0.90, 1.0) -- Added from template
setTacticsMults(NewShipType, "FIRERATE", 1.0, 1.25, 1.0) -- Added from template

--------------------------------------------------
--- Formations
--------------------------------------------------

NewShipType.paradeData = "vas_mothership_parade" -- Value from template
NewShipType.SquadronSize = getShipNum(NewShipType, "SquadronSize", 1)

--------------------------------------------------
--- Launching
--------------------------------------------------

addAbility(NewShipType, "CanLaunch")
NewShipType.launchTimeBetweenTwoFormations = 1
NewShipType.launchTimeBeforeStart = 2
NewShipType.launchNrOfShipsInDockFormation = 1
NewShipType.launchFormation = "delta"

--------------------------------------------------
--- Docking
--------------------------------------------------

addAbility(NewShipType, "CanDock", 1, 0)
NewShipType.dockTimeBetweenTwoFormations = 1
NewShipType.dockTimeBeforeStart = 2
NewShipType.dockNrOfShipsInDockFormation = 1
NewShipType.dockFormation = "delta"
NewShipType.queueFormation = "dockline"
NewShipType.dontDockWithOtherRaceShips = 1
NewShipType.ignoreRaceWhenDocking = 0

--------------------------------------------------
--- Ship Counter Rating
--------------------------------------------------

NewShipType.fighterValue = 0
NewShipType.corvetteValue = 0
NewShipType.frigateValue = 80
NewShipType.neutralValue = 30
NewShipType.antiFighterValue = 0
NewShipType.antiCorvetteValue = 5
NewShipType.antiFrigateValue = 60
NewShipType.totalValue = 110

--------------------------------------------------
--- Damage & Death
--------------------------------------------------

NewShipType.dustCloudDamageTime = 0
NewShipType.nebulaDamageTime = 0
NewShipType.collisionMultiplier = 1
NewShipType.battleScarCoverage = 4
NewShipType.battleScarBudgetLow = 1200
NewShipType.battleScarBudgetNext = 1800
NewShipType.sobDieTime = 16
NewShipType.sobSpecialDieTime = 1
NewShipType.specialDeathSpeed = 40
NewShipType.chanceOfSpecialDeath = 0
NewShipType.deadSobFadeTime = 0.1

--------------------------------------------------
--- Explosion Damage
--------------------------------------------------

NewShipType.minFalloffDamageDist = 1450 -- Added from template
NewShipType.maxFalloffDamageDist = 1450 * 1.5 -- Added from template
NewShipType.maxFalloffScuttleDamageDist = 1450 * 3 -- Added from template
NewShipType.explosiveScuttleDamageOnDeath = 3302 * 3 -- Added from template
NewShipType.maxFalloffForce = 500 * 10 -- Added from template
NewShipType.explosiveDamageOnDeath = 660 * 3 -- Added from template
NewShipType.radiusDamageEvadeMod = 1.1 -- Added from template

--------------------------------------------------
--- Death Tumble
--------------------------------------------------

NewShipType.tumbleStaticX = 0
NewShipType.tumbleStaticY = 0
NewShipType.tumbleStaticZ = 0
NewShipType.tumbleDynamicX = 0
NewShipType.tumbleDynamicY = 0
NewShipType.tumbleDynamicZ = 0
NewShipType.tumbleSpecialDynamicX = 0
NewShipType.tumbleSpecialDynamicY = 0
NewShipType.tumbleSpecialDynamicZ = 0

--------------------------------------------------
--- Selection
--------------------------------------------------

NewShipType.militaryUnit = 1
NewShipType.selectionLimit = 150000
NewShipType.preciseATILimit = 0
NewShipType.selectionPriority = 75

--------------------------------------------------
--- Tactical Overlay Icon
--------------------------------------------------

NewShipType.TOScale = 1
NewShipType.TOGroupScale = 1
NewShipType.TOGroupMergeSize = 0

--------------------------------------------------
--- Overlays
--------------------------------------------------

NewShipType.mouseOverMinFadeSize = 0.045
NewShipType.mouseOverMaxFadeSize = 0.1
NewShipType.healthBarStyle = 2
NewShipType.SMRepresentation = "Mesh"
NewShipType.SMHighlightDistMin = 15000 -- Value from template
NewShipType.SMHighlightDistMax = 25000 -- Value from template
NewShipType.canblink = 0

--------------------------------------------------
--- Rendering
--------------------------------------------------

NewShipType.AlwaysInRenderList = 1
NewShipType.meshRenderLimit = 50000000000
NewShipType.dotRenderLimit = 10
NewShipType.visibleInSecondary = 1
NewShipType.goblinsStartFade = 15000
NewShipType.goblinsOff = 30000
NewShipType.minimumZoomFactor = 0.5

--------------------------------------------------
--- Non linear Scaling
--------------------------------------------------

NewShipType.nlips = 0
NewShipType.nlipsRange = 75000
NewShipType.nlipsFar = 0
NewShipType.nlipsFarRange = 0

--------------------------------------------------
--- Level of Detail
--------------------------------------------------

NewShipType.minLOD = 0.25
NewShipType.upLOD = 20000
NewShipType.upLOD = 30000
NewShipType.upLOD = 50000
NewShipType.downLOD = 20015
NewShipType.downLOD = 30015
NewShipType.downLOD = 50015

--------------------------------------------------
--- Abilities
--------------------------------------------------

addAbility(NewShipType, "ParadeCommand", 1)
addAbility(NewShipType, "ShipHold", 1, 1000, 16, "rallypoint", "Fighter, Corvette, Utility", 40)
addAbility(
	NewShipType,
	"CanAttack",
	1,
	4,
	0,
	0,
	0.35,
	1,
	"Fighter, Fighter_hw1, Corvette, Corvette_hw1, Frigate, Utility, Resource,,,,SmallCapitalShip, BigCapitalShip",
	"JustShoot"
)
addAbility(
	NewShipType,
	"CanBuildShips",
	1,
	"Fighter_Ter, Bomber_Ter, Cruiser_Ter, SuperCap_Ter, Utility_Ter, Platform_Ter, Battlecruiser_Ter, Shipyard_Ter, Probe_Ter",
	"Utility, Fighter, Bomber, Cruiser, Capital, Platform"
)
addAbility(NewShipType, "CanBeCaptured", 1000, 0.1)
addAbility(NewShipType, "CanBeRepaired")

--------------------------------------------------
--- MODEL MUST LOAD AT THIS POINT
LoadModel(NewShipType, 1)
--------------------------------------------------

