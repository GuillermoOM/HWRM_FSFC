--------------------------------------------------
--- Base Template of a ship with all variables and functions organized by type
--- Variables: https://github.com/HWRM/KarosGraveyard/wiki/Variable;-Ship
--- Functions: https://github.com/HWRM/KarosGraveyard/wiki/Scope;-Ship
--------------------------------------------------

NewShipType = StartShipConfig()

--------------------------------------------------
--- Shipinfo
--------------------------------------------------

NewShipType.displayedName = "NTF Iceni"
NewShipType.sobDescription = "Command Frigate"

--------------------------------------------------
--- Main Ship Data
--------------------------------------------------

NewShipType.isTransferable = 0
NewShipType.unavailableWhenCaptured = 0 -- Added from template

--------------------------------------------------
--- Families
--------------------------------------------------

NewShipType.MinimalFamilyToFindPathAround = "MotherShip"
NewShipType.BuildFamily = "Shipyard_Ter"
NewShipType.AttackFamily = "SmallCapitalShip"
NewShipType.DockFamily = "SuperCap"
NewShipType.AvoidanceFamily = "Capital"
NewShipType.DisplayFamily = "Capital"
NewShipType.AutoFormationFamily = "CapShip"
NewShipType.CollisionFamily = "Big"
NewShipType.ArmourFamily = "HeavyArmour"

--------------------------------------------------
--- Supply
--------------------------------------------------

setSupplyValue(NewShipType, "Capital", 1.0) -- Added from template
setSupplyValue(NewShipType, "Iceni", 1.0) -- Added from template

--------------------------------------------------
--- Construction
--------------------------------------------------

NewShipType.buildBatch = getShipNum(NewShipType, "buildBatch", 1) -- Added from template
NewShipType.buildCost = 9000
NewShipType.buildTime = 210
NewShipType.buildPriorityOrder = 20
setConcurrentBuildLimit(NewShipType, 0, 2) -- Added from template

--------------------------------------------------
--- Health and Armour
--------------------------------------------------

NewShipType.maxhealth = 150000
NewShipType.regentime = 1000
NewShipType.minRegenTime = 1000
NewShipType.sideArmourDamage = 1
NewShipType.rearArmourDamage = 1.2

--------------------------------------------------
--- Shields
--------------------------------------------------

addShield(NewShipType, "EMP", 1000, 31)

--------------------------------------------------
--- Sensors
--------------------------------------------------

NewShipType.retaliationRange = 6000
NewShipType.retaliationDistanceFromGoal = 160
NewShipType.visualRange = 2000
NewShipType.prmSensorRange = 8500
NewShipType.secSensorRange = 12000
NewShipType.detectionStrength = 1

--------------------------------------------------
--- Movement
--------------------------------------------------

NewShipType.mass = 200000
NewShipType.thrusterMaxSpeed = 190
NewShipType.thrusterAccelTime = 8
NewShipType.thrusterBrakeTime = 4
NewShipType.mainEngineMaxSpeed = 190
NewShipType.mainEngineAccelTime = 8
NewShipType.mainEngineBrakeTime = 4
NewShipType.rotationMaxSpeed = 8
NewShipType.rotationAccelTime = 4
NewShipType.rotationBrakeTime = 2

--------------------------------------------------
--- Advanced Movement
--------------------------------------------------

NewShipType.controllerType = "Ship"
NewShipType.thrusterUsage = 1
NewShipType.accelerationAngle = 60
NewShipType.mirrorAngle = 0
NewShipType.secondaryTurnAngle = 0
NewShipType.maxBankingAmount = 40
NewShipType.descendPitch = 40
NewShipType.goalReachEpsilon = 25
NewShipType.slideMoveRange = 350
NewShipType.relativeMoveFactor = 1
NewShipType.useEngagementRanges = 1
NewShipType.swayUpdateTime = 6
NewShipType.swayOffsetRandomX = 10
NewShipType.swayOffsetRandomY = 10
NewShipType.swayOffsetRandomZ = 10
NewShipType.swayBobbingFactor = 0
NewShipType.swayRotateFactor = 0
NewShipType.useTargetRandom = 1
NewShipType.targetRandomPointXMin = -0.5
NewShipType.targetRandomPointXMax = 0.5
NewShipType.targetRandomPointYMin = -0.2
NewShipType.targetRandomPointYMax = 0.5
NewShipType.targetRandomPointZMin = -0.5
NewShipType.targetRandomPointZMax = 0.5

--------------------------------------------------
--- Tactics And Multipliers
--------------------------------------------------

NewShipType.defaultStance = "Neutral" -- Added from template
NewShipType.defaultROE = "Defensive" -- Added from template
setTacticsMults(NewShipType, "MAXSPEED", 0.85, 1.10, 1.0) -- Added from template
setTacticsMults(NewShipType, "ENGINEACCEL", 0.85, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "ENGINEBRAKE", 1.15, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "THRUSTER", 1.0, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "THRUSTERACCEL", 0.85, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "THRUSTERBRAKE", 1.0, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "ROTATION", 1.15, 1.05, 1.0) -- Added from template
setTacticsMults(NewShipType, "ROTATIONACCEL", 1.0, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "ROTATIONBRAKE", 1.15, 1.0, 1.0) -- Added from template
setTacticsMults(NewShipType, "WEAPONACCURACY", 1.05, 0.85, 1.0) -- Added from template
setTacticsMults(NewShipType, "WEAPONDAMAGE", 1.25, 0.75, 1.0) -- Added from template
setTacticsMults(NewShipType, "BULLETSPEED", 1.10, 0.90, 1.0) -- Added from template
setTacticsMults(NewShipType, "DAMAGEAPPLIED", 1.10, 0.90, 1.0) -- Added from template
setTacticsMults(NewShipType, "FIRERATE", 1.0, 1.25, 1.0) -- Added from template

--------------------------------------------------
--- Formations
--------------------------------------------------

NewShipType.paradeData = "shivan_parade" -- Added from template
NewShipType.SquadronSize = 1
NewShipType.formationSpacing = 400 -- Added from template
NewShipType.passiveFormation = "Spear"
NewShipType.defensiveFormation = "x"
NewShipType.aggressiveFormation = "Claw"
NewShipType.noCombatGrouping = 0 -- Added from template
NewShipType.canJoinStrikeGroup = 1 -- Added from template
NewShipType.strikeGroupRadius = 350 -- Added from template
NewShipType.strikeGroupSpeed = 5000 -- Added from template

--------------------------------------------------
--- Launching
--------------------------------------------------

addAbility(NewShipType, "CanLaunch")
NewShipType.launchTimeBetweenTwoFormations = 1
NewShipType.launchTimeBeforeStart = 2
NewShipType.launchNrOfShipsInDockFormation = 1
NewShipType.launchFormation = "delta"

--------------------------------------------------
--- Docking
--------------------------------------------------

addAbility(NewShipType, "CanDock", 1, 0) -- Using template version
NewShipType.dockTimeBetweenTwoFormations = 1
NewShipType.dockTimeBeforeStart = 2
NewShipType.dockNrOfShipsInDockFormation = 1
NewShipType.dockFormation = "delta"
NewShipType.queueFormation = "dockline"
NewShipType.dontDockWithOtherRaceShips = 1
NewShipType.ignoreRaceWhenDocking = 0

--------------------------------------------------
--- Ship Counter Rating
--------------------------------------------------

NewShipType.fighterValue = 0
NewShipType.corvetteValue = 0
NewShipType.frigateValue = 40
NewShipType.neutralValue = 10
NewShipType.antiFighterValue = 0
NewShipType.antiCorvetteValue = 0
NewShipType.antiFrigateValue = 30
NewShipType.totalValue = 50

--------------------------------------------------
--- Damage & Death
--------------------------------------------------

NewShipType.dustCloudDamageTime = 160
NewShipType.nebulaDamageTime = 300
NewShipType.collisionMultiplier = 1
NewShipType.battleScarCoverage = 4
NewShipType.battleScarBudgetLow = 1200
NewShipType.battleScarBudgetNext = 1800
NewShipType.sobDieTime = 3.5
NewShipType.sobSpecialDieTime = 1
NewShipType.specialDeathSpeed = 40
NewShipType.chanceOfSpecialDeath = 0
NewShipType.deadSobFadeTime = 0.1

