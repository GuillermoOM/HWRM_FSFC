function NonDetermChunk()
  fogSetActive(0)
  setGlareIntensity(0.00)
  setLevelShadowColour(0,0.03,0.09,1)
  loadBackground("gammadraconis")
  setSensorsManagerCameraDistances(5000, 55000)

	local ambientTracks = {
		"data:sound/music/fs2_aquits",
		"data:sound/music/fs2_bastion",
