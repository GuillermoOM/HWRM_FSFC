function NonDetermChunk()
  fogSetActive(0)
  setGlareIntensity(0.00)
  setLevelShadowColour(0,0,0,1)
  loadBackground("polaris")
  setSensorsManagerCameraDistances(10000, 150000)

	local ambientTracks = {
		"data:sound/music/fs2_aquits",
